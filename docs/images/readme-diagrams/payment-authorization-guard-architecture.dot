digraph PaymentAuthorizationGuardArchitecture {
  graph [rankdir=LR, bgcolor="transparent", splines=ortho, fontnames=svg, nodesep=0.55, ranksep=0.75]
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=12, margin="0.16,0.10", color="#48758d", penwidth=1.5]
  edge [fontname="Comic Mono", fontsize=10, color="#47616f", penwidth=1.7, arrowsize=0.8]

  order [label="Order workflow\ncaller-owned", fillcolor="#d7ecf2"]
  request [label="Request validation\nnon-sensitive metadata", fillcolor="#edf1e9", color="#5d8a62"]
  authorizer [label="Authorizer\nexample domain boundary", fillcolor="#f7e5aa", color="#b99b5d"]
  breaker [label="Circuit breaker\nouter policy", fillcolor="#f5d3df", color="#b95f7a"]
  bulkhead [label="Bulkhead\ninner policy", fillcolor="#eadcf5", color="#8a6bb0"]
  gateway [label="Payment gateway\ncaller-supplied function", fillcolor="#f9dacd", color="#ba705c"]
  events [label="Event sink\nsynchronous OnEvent", fillcolor="#efe7d2", color="#a78335"]

  order -> request [xlabel="Authorize"]
  request -> authorizer [xlabel="validated"]
  authorizer -> breaker [xlabel="Run"]
  breaker -> bulkhead [xlabel="admit"]
  bulkhead -> gateway [xlabel="call"]
  gateway -> order [xlabel="Authorization"]
  breaker -> events [xlabel="transition / rejection"]
  bulkhead -> events [xlabel="admission / rejection"]
}
