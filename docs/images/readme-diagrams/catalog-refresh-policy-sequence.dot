digraph CatalogRefreshPolicySequence {
  graph [rankdir=LR, bgcolor="transparent", splines=ortho, nodesep=0.45, ranksep=0.8]
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=12, margin="0.14,0.10", color="#526d7a", penwidth=1.4]
  edge [fontname="Comic Mono", fontsize=10, color="#47616f", penwidth=1.6, arrowsize=0.75]

  caller [label="Caller", fillcolor="#d7ecf2"]
  retry [label="Retry policy\nouter wrapper", fillcolor="#f7e5aa"]
  timeout1 [label="Timeout policy\nattempt 1", fillcolor="#f9dacd"]
  source1 [label="Source call\ntransient error", fillcolor="#f4c7c0"]
  timeout2 [label="Timeout policy\nattempt 2", fillcolor="#d8ead4"]
  source2 [label="Source call\nproduct", fillcolor="#cfe7cf"]
  result [label="Product result", fillcolor="#dfd9f2"]

  caller -> retry [xlabel="Refresh"]
  retry -> timeout1 [xlabel="attempt 1"]
  timeout1 -> source1 [xlabel="deadline ctx"]
  source1 -> retry [xlabel="error"]
  retry -> timeout2 [xlabel="attempt 2"]
  timeout2 -> source2 [xlabel="new deadline ctx"]
  source2 -> result [xlabel="success"]
}
