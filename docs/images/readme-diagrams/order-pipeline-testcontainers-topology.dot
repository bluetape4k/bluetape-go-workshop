digraph G {
  graph [
    rankdir=LR,
    bgcolor="#fffdf8",
    margin=0.18,
    pad=0.18,
    nodesep=0.45,
    ranksep=0.7,
    splines=ortho,
    fontname="Architects Daughter",
    label="Order Pipeline Testcontainers Topology",
    labelloc=t,
    fontsize=30,
    fontcolor="#24313f"
  ];
  node [
    shape=rect,
    style="rounded,filled",
    penwidth=2,
    fontname="Comic Mono",
    fontsize=16,
    color="#64748b",
    fontcolor="#24313f",
    margin="0.16,0.12"
  ];
  edge [color="#64748b", penwidth=2, arrowsize=0.75];

  test [label="Go test\nstarts fixtures", fillcolor="#fef3c7", width=2.0];
  fixtures [label="bluetape-go\ntestcontainers", fillcolor="#dbeafe", width=2.0];
  postgres [label="PostgreSQL\norder projection", fillcolor="#dcfce7", width=2.1];
  redis [label="Redis\nidempotency marker", fillcolor="#fee2e2", width=2.1];
  nats [label="NATS\norder event", fillcolor="#fce7f3", width=2.0];
  assert [label="Assertions\nquery + subscribe", fillcolor="#e0e7ff", width=2.15];

  test -> fixtures;
  fixtures -> postgres;
  fixtures -> redis;
  fixtures -> nats;
  postgres -> assert;
  redis -> assert;
  nats -> assert;
}
