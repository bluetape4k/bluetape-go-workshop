digraph CatalogNearCacheRedisArchitecture {
  graph [rankdir=LR, bgcolor="transparent", splines=ortho, fontnames=svg, nodesep=0.65, ranksep=0.90]
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=12, margin="0.16,0.10", color="#48758d", penwidth=1.5]
  edge [fontname="Comic Mono", fontsize=10, color="#47616f", penwidth=1.7, arrowsize=0.8]

  api [label="Peer API\nGetProduct / PutProduct", fillcolor="#d7ecf2"]
  stampede [label="rediscoord.StampedeCache\nGetOrLoad owner token", fillcolor="#f7e5aa", color="#b99b5d"]
  near [label="redisnear.NearCache\nPub/Sub invalidation", fillcolor="#eadcf5", color="#8a6bb0"]
  memory [label="cache.NewMemory\nper-peer local entries", fillcolor="#dbe8d4", color="#5d8a62"]
  redis [label="Redis client\nlocks, results, invalidations", fillcolor="#f5d3df", color="#b95f7a"]
  store [label="Store.Load / Store.Put\nauthoritative projection", fillcolor="#efe7d2", color="#a78335"]

  api -> stampede [xlabel="GetOrLoad"]
  stampede -> near [xlabel="cache read/write"]
  near -> memory [xlabel="local cache"]
  near -> redis [xlabel="pub/sub"]
  stampede -> redis [xlabel="lock + result"]
  stampede -> store [xlabel="owner loader"]
  api -> store [xlabel="write source"]
  api -> near [xlabel="Set publishes"]
}
