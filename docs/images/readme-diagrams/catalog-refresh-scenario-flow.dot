digraph CatalogRefreshScenario {
  graph [rankdir=LR, bgcolor="transparent", splines=ortho, fontnames=svg, nodesep=0.7, ranksep=0.9]
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=12, margin="0.16,0.10", color="#48758d", penwidth=1.5]
  edge [fontname="Comic Mono", fontsize=10, color="#47616f", penwidth=1.7, arrowsize=0.8]

  job [label="Refresh job\nSKU request", fillcolor="#d7ecf2"]
  policies [label="Retry + timeout\npolicy wrapper", fillcolor="#f7e5aa"]
  source [label="Catalog provider\nflaky upstream", fillcolor="#f7d6c8"]
  model [label="Storefront read model\nfresh product", fillcolor="#d8ead4"]
  events [label="Resilience events\nretry / success / timeout", fillcolor="#eadcf5"]

  job -> policies [xlabel="Refresh(sku)"]
  policies -> source [xlabel="attempt"]
  source -> policies [xlabel="product or error"]
  policies -> model [xlabel="success"]
  policies -> events [xlabel="OnEvent"]
}
