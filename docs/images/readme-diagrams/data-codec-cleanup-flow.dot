digraph G {
  graph [
    rankdir=TB,
    bgcolor="#fffdf8",
    margin=0.18,
    pad=0.18,
    nodesep=0.35,
    ranksep=0.45,
    splines=ortho,
    fontnames=svg,
    fontname="Architects Daughter",
    label="Data Codec and Cleanup Flow",
    labelloc=t,
    fontsize=30,
    fontcolor="#24313f"
  ];
  node [
    shape=rect,
    style="rounded,filled",
    penwidth=2,
    fontname="Comic Mono",
    fontsize=16,
    color="#64748b",
    fontcolor="#24313f",
    margin="0.16,0.12"
  ];
  edge [color="#64748b", penwidth=2, arrowsize=0.75];

  input [label="External data\npartner feed / snapshot / URL", fillcolor="#fef3c7", width=3.2];
  validate [label="Validate shape\nrequired fields + decoded state", fillcolor="#dbeafe", width=3.2];
  normalize [label="Normalize values\ndefaults + dedupe + grouping", fillcolor="#dcfce7", width=3.2];
  encode [label="Encode payload\nBase62 / Base64URL / Hex", fillcolor="#fce7f3", width=3.2];
  persist [label="Persist or hand off\nversioned JSON + compression", fillcolor="#e0e7ff", width=3.2];
  tests [label="Tests prove\nround trip + corrupt input", fillcolor="#f8fafc", width=3.2];

  input -> validate -> normalize -> encode -> persist -> tests;
}
