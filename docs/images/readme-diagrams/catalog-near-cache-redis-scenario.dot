digraph CatalogNearCacheRedisScenario {
  graph [rankdir=LR, bgcolor="transparent", splines=ortho, fontnames=svg, nodesep=0.60, ranksep=0.85]
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=12, margin="0.16,0.10", color="#48758d", penwidth=1.5]
  edge [fontname="Comic Mono", fontsize=10, color="#47616f", penwidth=1.7, arrowsize=0.8]

  shopper [label="Catalog request\nSKU lookup", fillcolor="#d7ecf2"]
  peer_a [label="Peer A\nlocal memory", fillcolor="#f7e5aa", color="#b99b5d"]
  peer_b [label="Peer B\nlocal memory", fillcolor="#f7e5aa", color="#b99b5d"]
  redis [label="Redis\nPub/Sub + locks", fillcolor="#f5d3df", color="#b95f7a"]
  store [label="Authoritative store\nproduct projection", fillcolor="#dbe8d4", color="#5d8a62"]
  invalidation [label="Invalidation\npeer B evicts SKU", fillcolor="#eadcf5", color="#8a6bb0"]

  shopper -> peer_b [xlabel="GetProduct"]
  peer_b -> redis [xlabel="cold miss lock"]
  redis -> store [xlabel="single owner loads"]
  store -> peer_b [xlabel="Product v1"]
  peer_a -> store [xlabel="PutProduct v2"]
  peer_a -> redis [xlabel="publish Set"]
  redis -> invalidation [xlabel="origin filtered event"]
  invalidation -> peer_b [xlabel="delete local SKU"]
  peer_b -> store [xlabel="reload v2"]
}
